import pandas as pd
df = pd.read_csv("https://raw.githubusercontent.com/data-bootcamp-v4/data/main/marketing_customer_analysis.csv")
df.head()
# Clean Columns
df.columns = df.columns.str.lower().str.replace(" ", "_")

# Create a new DataFrame
df_low_claim_yes = df[(df["total_claim_amount"] < 1000) & (df["response"] == "Yes")]
df_low_claim_yes.head()

df_yes = df[df["response"] == "Yes"]
pivot_insights = df_yes.pivot_table(
    values=["monthly_premium_auto", "customer_lifetime_value"],
    index="policy_type",
    columns="gender",
    aggfunc="mean"
).round(2)
pivot_insights

state_counts = df["state"].value_counts()
state_counts[state_counts > 500]

clv_stats = df.pivot_table(
    values="customer_lifetime_value",
    index=["education", "gender"],
    aggfunc=["max", "min", "median"]
).round(2)
clv_stats


# --- BONUS ---

df["effective_to_date"] = pd.to_datetime(df["effective_to_date"])
df["month"] = df["effective_to_date"].dt.month_name()

policies_by_state_month = df.pivot_table(
    values="policy",  
    index="state",
    columns="month",
    aggfunc="count",
    fill_value=0
)
policies_by_state_month

policies_by_state = df["state"].value_counts().head(3)
top3_states = policies_by_state.index.tolist()
top3_states

df_top3 = df[df["state"].isin(top3_states)]
top3_table = df_top3.pivot_table(
    values="policy",
    index="state",
    columns="month",
    aggfunc="count",
    fill_value=0
)
top3_table
